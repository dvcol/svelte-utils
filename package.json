{
  "name": "@dvcol/svelte-utils",
  "type": "module",
  "version": "3.2.1",
  "packageManager": "pnpm@11.2.2",
  "description": "Svelte library for common utility functions and constants",
  "author": "dvcol",
  "license": "MIT",
  "homepage": "https://github.com/dvcol/svelte-utils",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvcol/svelte-utils.git"
  },
  "bugs": "https://github.com/dvcol/svelte-utils/issues",
  "keywords": [
    "typescript",
    "library",
    "svelte",
    "svelte 5",
    "svelte-utils"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./component": {
      "types": "./dist/components/index.d.ts",
      "svelte": "./dist/components/index.js",
      "import": "./dist/components/index.js"
    },
    "./transition": {
      "types": "./dist/transitions/index.d.ts",
      "svelte": "./dist/transitions/index.js",
      "import": "./dist/transitions/index.js"
    },
    "./debounce": {
      "types": "./dist/debounce/index.d.ts",
      "svelte": "./dist/debounce/index.js",
      "import": "./dist/debounce/index.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "svelte": "./dist/media/index.js",
      "import": "./dist/media/index.js"
    },
    "./watch": {
      "types": "./dist/watch/index.d.ts",
      "svelte": "./dist/watch/index.js",
      "import": "./dist/watch/index.js"
    },
    "./mutation": {
      "types": "./dist/mutation/index.d.ts",
      "svelte": "./dist/mutation/index.js",
      "import": "./dist/mutation/index.js"
    },
    "./resize": {
      "types": "./dist/resize/index.d.ts",
      "svelte": "./dist/resize/index.js",
      "import": "./dist/resize/index.js"
    },
    "./swipe": {
      "types": "./dist/swipe/index.d.ts",
      "svelte": "./dist/swipe/index.js",
      "import": "./dist/swipe/index.js"
    },
    "./focusin": {
      "types": "./dist/focusin/index.d.ts",
      "svelte": "./dist/focusin/index.js",
      "import": "./dist/focusin/index.js"
    },
    "./hovering": {
      "types": "./dist/hovering/index.d.ts",
      "svelte": "./dist/hovering/index.js",
      "import": "./dist/hovering/index.js"
    },
    "./intersection": {
      "types": "./dist/intersection/index.d.ts",
      "svelte": "./dist/intersection/index.js",
      "import": "./dist/intersection/index.js"
    }
  },
  "main": "./dist/index.js",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "!dist/**/*.spec.*",
    "!dist/**/*.test.*",
    "*.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=24",
    "pnpm": ">= 8"
  },
  "scripts": {
    "prepare": "husky",
    "vite:build": "vite build",
    "build": "run-s vite:build package",
    "package": "svelte-kit sync && svelte-package && publint",
    "prepublishOnly": "npm run package",
    "check:type": "tsc -p tsconfig.build.json",
    "check:type:watch": "tsc -p tsconfig.build.json --watch",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig tsconfig.build.json",
    "check:svelte:watch": "svelte-kit sync && svelte-check --tsconfig tsconfig.build.json --watch",
    "check": "run-s check:type check:svelte",
    "check:watch": "run-p check:type:watch check:svelte:watch",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test:unit": "vitest --run --coverage",
    "test:watch": "vitest",
    "release": "standard-version",
    "release:changelog": "extract-changelog-release > RELEASE.md"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "svelte": ">=5.29"
  },
  "dependencies": {
    "@dvcol/common-utils": "^1.34.0",
    "svelte": "^5.55.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@dvcol/eslint-config": "^1.8.6",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.59.1",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@tsconfig/node24": "^24.0.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/dom-view-transitions": "^1.0.6",
    "@types/node": "^25.7.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "eslint-plugin-svelte": "^3.17.1",
    "extract-changelog-release": "^1.0.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.4",
    "navigation-api-types": "^0.6.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.2",
    "publint": "^0.3.21",
    "standard-version": "^9.5.0",
    "svelte-check": "^4.4.8",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vite-plugin-checker": "^0.13.0",
    "vitest": "^4.1.5"
  }
}
